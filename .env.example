# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5433/trading
REDIS_URL=redis://localhost:6380/0
DEBUG=false

# --- Environment: paper is the default and the only supported mode today ---
TRADING_ENV=paper

# --- Alpaca PAPER credentials (https://app.alpaca.markets, paper account) ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# --- Alpaca LIVE credentials: leave empty until live trading is deliberately enabled.
# Live trading additionally requires TRADING_ENV=live, LIVE_TRADING_ENABLED=true,
# LIVE_TRADING_CONFIRMATION set to the exact phrase in app/config.py, AND the
# runtime arm switch set via the admin API. All five, or the platform stays paper.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=

# --- TradingView webhook validation ---
# Shared passphrase that must appear as "secret" in the webhook JSON payload.
TRADINGVIEW_WEBHOOK_SECRET=change-me
# Optional HMAC-SHA256 secret for senders that can set an X-Signature header.
WEBHOOK_HMAC_SECRET=
WEBHOOK_MAX_SIGNAL_AGE_SECONDS=120

# --- Risk limits (conservative defaults; tighten/loosen deliberately) ---
# These are sized to be COHERENT with profile.toml's default capital_allocation
# of $25,000. The largest single leg any shipped persona wants is All Weather's
# 40% bond sleeve = $10,000, so the order/position caps sit just above it and
# gross exposure just above the full allocation. If you raise
# capital_allocation, raise these to match or the risk engine will (correctly)
# reject the resulting orders. They remain an INDEPENDENT ceiling: the profile
# cannot widen them.
RISK_MAX_ORDER_NOTIONAL=11000
RISK_MAX_POSITION_NOTIONAL=11000
RISK_MAX_GROSS_EXPOSURE=26000
RISK_MAX_DAILY_LOSS=500
RISK_MAX_DRAWDOWN_PCT=10
RISK_DUPLICATE_WINDOW_SECONDS=60
RISK_MAX_DATA_AGE_SECONDS=259200  # 3 days: daily bars are never fresher than the last close
RISK_CIRCUIT_BREAKER_ERRORS=5
RISK_CIRCUIT_BREAKER_WINDOW_SECONDS=300
# Comma-separated symbols the platform may trade; empty allows any US equity.
RISK_SYMBOL_ALLOWLIST=SPY,QQQ,AAPL,MSFT,VTI,TLT,IEI,GLD,DBC,BIL

# --- Admin API ---
# Required in X-Admin-Token header for /admin endpoints; empty disables the admin API.
ADMIN_API_TOKEN=change-me-admin

# --- Strategy context ---
# Benchmark symbol whose trailing returns feed relative-strength criteria.
# Empty disables benchmark injection (those criteria are then skipped + flagged).
STRATEGY_BENCHMARK_SYMBOL=SPY
